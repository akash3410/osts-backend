# ---------------------------------------------------------------------------
# OSTS environment configuration (template)
#
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit
# secrets. Every variable below is read in osts/settings/.
# ---------------------------------------------------------------------------

# Which settings module to load: dev (default) or prod
OSTS_ENV=dev

# ---- Core security -------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import \
#   get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Comma-separated hosts, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins for CSRF, e.g. https://osts.com,https://www.osts.com
CSRF_TRUSTED_ORIGINS=

# ---- Database ------------------------------------------------------------
# Leave DATABASE_URL unset for local SQLite.
# PostgreSQL: postgres://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=
CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5

# ---- Cache / sessions ----------------------------------------------------
# Leave unset for local in-memory cache. Redis: redis://127.0.0.1:6379/1
REDIS_URL=

# ---- Email ---------------------------------------------------------------
# dev: console (prints to terminal). prod: smtp://... or an API backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@osts.local

# ---- HTTPS / transport security (prod) -----------------------------------
# Set to 1 once HTTPS is live. Raise HSTS gradually (e.g. 31536000 = 1yr).
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0

# ---- Login throttling (django-axes) --------------------------------------
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# ---- Social login (allauth reads these via seed_social_apps) -------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=

# ---- Payments (Phase 6: SSLCommerz) --------------------------------------
SSLZ_STORE_ID=
SSLZ_STORE_PASSWORD=
SSLZ_SANDBOX=1
